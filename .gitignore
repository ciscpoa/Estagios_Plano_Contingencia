arquivos_gerados_2026/*
!arquivos_gerados_2026/.gitkeep
!dados/.gitkeep

# Site gerado (publicado pelo Actions, não precisa versionar)
site/

# ── Caches ──
__pycache__/
*.pyc
.cft/
.ipynb_checkpoints/
